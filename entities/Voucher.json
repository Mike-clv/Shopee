{
  "name": "Voucher",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Ti\u00eau \u0111\u1ec1 voucher"
    },
    "slug": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "M\u00e3 coupon"
    },
    "description": {
      "type": "string"
    },
    "terms": {
      "type": "string",
      "description": "\u0110i\u1ec1u ki\u1ec7n \u00e1p d\u1ee5ng"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percent",
        "fixed",
        "cashback",
        "freeship",
        "gift"
      ],
      "description": "Lo\u1ea1i gi\u1ea3m gi\u00e1"
    },
    "discount_value": {
      "type": "string",
      "description": "Gi\u00e1 tr\u1ecb gi\u1ea3m (VD: 50%, 100K)"
    },
    "min_order_value": {
      "type": "string",
      "description": "\u0110\u01a1n t\u1ed1i thi\u1ec3u"
    },
    "max_discount": {
      "type": "string",
      "description": "Gi\u1ea3m t\u1ed1i \u0111a"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expiring_soon",
        "expired",
        "draft"
      ],
      "default": "active"
    },
    "voucher_type": {
      "type": "string",
      "enum": [
        "coupon",
        "deal",
        "cashback",
        "freeship",
        "flash_sale",
        "exclusive"
      ],
      "default": "coupon"
    },
    "platform": {
      "type": "string",
      "enum": [
        "shopee",
        "lazada",
        "tiki",
        "tiktok_shop",
        "sendo",
        "other"
      ]
    },
    "brand_id": {
      "type": "string",
      "description": "ID th\u01b0\u01a1ng hi\u1ec7u"
    },
    "brand_name": {
      "type": "string"
    },
    "brand_logo": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "original_url": {
      "type": "string",
      "description": "URL g\u1ed1c"
    },
    "tracking_url": {
      "type": "string",
      "description": "Affiliate tracking URL"
    },
    "image": {
      "type": "string"
    },
    "is_hot": {
      "type": "boolean",
      "default": false
    },
    "is_verified": {
      "type": "boolean",
      "default": false
    },
    "is_exclusive": {
      "type": "boolean",
      "default": false
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "click_count": {
      "type": "number",
      "default": 0
    },
    "copy_count": {
      "type": "number",
      "default": 0
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "accesstrade_id": {
      "type": "string"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "slug"
  ]
}