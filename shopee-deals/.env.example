# ==== Database ====
# For production (Vercel / any hosted Postgres, e.g. Neon):
DATABASE_URL=postgresql://user:password@host:5432/shopee_deals

# Leave DATABASE_URL empty in local dev to use the built-in PGlite database (.db-pglite/).

# ==== Site ====
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==== Admin panel (/admin) ====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# Session-signing secret. Rotating it instantly invalidates issued admin
# cookies (old signed cookies fail HMAC verification). Required in production.
AUTH_SECRET=dev-only-change-me

# ==== Accesstrade ====
# Access key from https://pub.accesstrade.vn/publisher_profile/personal_info
ACCESSTRADE_ACCESS_KEY=
ACCESSTRADE_API_BASE=https://api.accesstrade.vn
# Merchant to sync coupon offers from (comma separated)
ACCESSTRADE_MERCHANTS=shopee
# Product datafeeds (Tiki/Lazada deals): domains + pages per sync run
ACCESSTRADE_DATAFEED_DOMAINS=lazada.vn,tiki.vn
ACCESSTRADE_DATAFEED_PAGES=2
# TikTok Shop product sync: keywords + per-keyword result limit
ACCESSTRADE_TIKTOK_KEYWORDS=quần,áo,giày,mỹ phẩm
ACCESSTRADE_TIKTOK_LIMIT=10
# Shared secret protecting /api/cron/sync.
# REQUIRED in production (the endpoint returns 403 without it as a safe
# default); local dev works without it. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" once the env var is set on the project.
CRON_SECRET=
